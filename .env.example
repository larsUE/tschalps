# Drizzle
DATABASE_URL=data/tschalps.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Uploads (GPX, photos), outside the web root
UPLOAD_DIR=data/uploads

# Mail (Infomaniak SMTP). Leave SMTP_HOST empty in development to log mails to the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tschalps <noreply@example.ch>"
